{
  "name": "stacknav-workspace",
  "private": true,
  "description": "iOS-style push/pop navigation for the web: a framework-agnostic core plus Angular and React ports.",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' build",
    "build:all": "pnpm -r build",
    "test": "pnpm --filter @stacknav/core test && pnpm --filter @stacknav/react test",
    "typecheck": "pnpm --filter @stacknav/core typecheck && pnpm --filter @stacknav/react typecheck",
    "size": "pnpm --filter @stacknav/core size && pnpm --filter @stacknav/angular size && pnpm --filter @stacknav/react size",
    "e2e": "pnpm build && pnpm e2e:angular && pnpm e2e:react",
    "e2e:angular": "pnpm --filter @stacknav/angular-demo build && pnpm --filter @stacknav/angular-demo e2e",
    "e2e:react": "pnpm --filter @stacknav/react-demo build && pnpm --filter @stacknav/react-demo e2e",
    "dev:demo": "pnpm --filter @stacknav/demo dev",
    "dev:angular": "pnpm --filter @stacknav/angular-demo start",
    "dev:react": "pnpm --filter @stacknav/react-demo dev",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.2"
  }
}
