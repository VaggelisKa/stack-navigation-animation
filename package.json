{
  "name": "stacknav-workspace",
  "private": true,
  "description": "Native-style (iOS and Android) push/pop navigation for the web: a framework-agnostic core plus Angular (and React) ports.",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' build",
    "build:all": "pnpm -r build",
    "test": "pnpm --filter @stacknav/core test && pnpm --filter @stacknav/angular test",
    "typecheck": "pnpm --filter @stacknav/core build && pnpm --filter @stacknav/core typecheck && pnpm --filter @stacknav/angular typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "size": "pnpm --filter @stacknav/core size && pnpm --filter @stacknav/angular size",
    "e2e": "pnpm build && pnpm --filter @stacknav/angular-demo build && pnpm --filter @stacknav/angular-demo e2e",
    "dev:demo": "pnpm --filter @stacknav/demo dev",
    "dev:angular": "pnpm --filter @stacknav/angular-demo start",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@eslint/js": "catalog:",
    "angular-eslint": "catalog:",
    "eslint": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
