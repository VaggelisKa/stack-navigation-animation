{
  "name": "stacknav-workspace",
  "private": true,
  "description": "Native-style (iOS and Android) push/pop navigation for the web: a framework-agnostic core plus Angular (and React) ports.",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' build",
    "build:all": "pnpm -r build",
    "test": "pnpm --filter @stacknav/core test && pnpm --filter @stacknav/angular test",
    "typecheck": "pnpm --filter @stacknav/core typecheck && pnpm --filter @stacknav/angular typecheck",
    "lint": "eslint .",
    "size": "pnpm --filter @stacknav/core size && pnpm --filter @stacknav/angular size",
    "e2e": "pnpm build && pnpm --filter @stacknav/angular-demo build && pnpm --filter @stacknav/angular-demo e2e",
    "dev:demo": "pnpm --filter @stacknav/demo dev",
    "dev:angular": "pnpm --filter @stacknav/angular-demo start",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.2",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "^22.5.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "typescript-eslint": "^8.70.0"
  }
}
