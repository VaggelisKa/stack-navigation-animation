{
  "name": "@stacknav/angular",
  "version": "1.1.1",
  "description": "Native-style (iOS and Android) push/pop transitions on Angular's own router outlet, with pages kept alive beneath the top one, built on @stacknav/core.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VaggelisKa/stack-navigation-animation.git",
    "directory": "packages/angular"
  },
  "homepage": "https://github.com/VaggelisKa/stack-navigation-animation/tree/main/packages/angular#readme",
  "bugs": "https://github.com/VaggelisKa/stack-navigation-animation/issues",
  "keywords": [
    "angular",
    "router",
    "router-outlet",
    "navigation",
    "transition",
    "ios",
    "android",
    "swipe-back",
    "stack",
    "animation"
  ],
  "scripts": {
    "build": "ng-packagr -p ng-package.json -c tsconfig.lib.json && node ../../scripts/copy-license.mjs dist",
    "test": "ng test",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit",
    "size": "node scripts/size.mjs"
  },
  "peerDependencies": {
    "@angular/common": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/router": "^22.0.0",
    "rxjs": "^7.4.0"
  },
  "dependencies": {
    "@stacknav/core": "workspace:^",
    "tslib": "catalog:"
  },
  "devDependencies": {
    "@angular/animations": "catalog:",
    "@angular/build": "catalog:",
    "@angular/cli": "catalog:",
    "@angular/common": "catalog:",
    "@angular/compiler": "catalog:",
    "@angular/compiler-cli": "catalog:",
    "@angular/core": "catalog:",
    "@angular/platform-browser": "catalog:",
    "@angular/router": "catalog:",
    "jsdom": "catalog:",
    "ng-packagr": "catalog:",
    "rxjs": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zone.js": "catalog:"
  },
  "sideEffects": false,
  "type": "module",
  "module": "./dist/fesm2022/stacknav-angular.mjs",
  "typings": "./dist/types/stacknav-angular.d.ts",
  "publishConfig": {
    "directory": "dist",
    "linkDirectory": true
  }
}
