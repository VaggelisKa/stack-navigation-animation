{
  "name": "@stacknav/core",
  "version": "0.3.0",
  "description": "Framework-agnostic iOS-style push/pop navigation stack: transition, interactive swipe back, direction resolution, history mirroring.",
  "license": "MIT",
  "type": "module",
  "keywords": ["navigation", "transition", "ios", "swipe-back", "stack", "animation"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./stacknav.css": "./dist/stacknav.css",
    "./package.json": "./package.json"
  },
  "files": ["dist", "src"],
  "sideEffects": ["*.css"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/write-css.mjs",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "size": "node scripts/size.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.0",
    "typescript": "~6.0.0"
  }
}
